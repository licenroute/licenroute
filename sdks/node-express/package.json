{
  "name": "@licenroute/connect-express",
  "version": "0.8.1",
  "license": "Apache-2.0",
  "description": "LicenRoute Connect: middleware para Express 4/5 (y Connect) que consulta la Decision API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.3.0",
    "@licenroute/policy-contracts": "0.2.0",
    "esbuild": "0.28.2",
    "typebox": "^1.3.36"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/licenroute/licenroute.git",
    "directory": "sdks/node-express"
  },
  "homepage": "https://licenroute.com",
  "bugs": {
    "url": "https://github.com/licenroute/licenroute/issues"
  },
  "author": "LicenRoute",
  "keywords": [
    "express",
    "middleware",
    "api",
    "license-keys",
    "quota",
    "paywall",
    "http-402"
  ]
}
