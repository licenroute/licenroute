{
  "name": "@licenroute/connect-express",
  "version": "0.8.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "LicenRoute Connect: middleware para Express 4/5 (y Connect) que consulta la Decision API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.3.0",
    "@licenroute/policy-contracts": "0.2.0",
    "esbuild": "0.28.2"
  }
}
