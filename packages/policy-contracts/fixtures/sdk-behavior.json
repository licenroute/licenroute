{
  "description": "Respuesta HTTP del SDK según lo que devuelve la Decision API (F3-02, F3-03, F3-11..F3-14). `api`: respuesta simulada. `fallback`: fallback efectivo de la ruta. `expect.outcome`: 'next' (la petición continúa hacia la app) o un código HTTP generado por el SDK. `cacheable`: si la decisión puede reutilizarse durante ttl_seconds. Compartido por el SDK de Express y el de Rails.",
  "cases": [
    { "name": "allow",                         "api": { "status": 200, "body": { "action": "allow", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 10 } }, "fallback": "fail_open", "expect": { "outcome": "next", "cacheable": true } },
    { "name": "allow sin ttl",                 "api": { "status": 200, "body": { "action": "allow", "risk_score": 0, "reason_codes": ["UNDER_RATE_LIMIT"], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": "next", "cacheable": false } },
    { "name": "block",                         "api": { "status": 200, "body": { "action": "block", "risk_score": 0, "reason_codes": ["RULE_MATCH_BLOCK"], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": 403, "cacheable": false } },
    { "name": "block con ttl (no se cachea)",  "api": { "status": 200, "body": { "action": "block", "risk_score": 90, "reason_codes": ["SCORE_THRESHOLD"], "policy_version": 1, "ttl_seconds": 30 } }, "fallback": "fail_open", "expect": { "outcome": 403, "cacheable": false } },
    { "name": "rate_limit",                    "api": { "status": 200, "body": { "action": "rate_limit", "risk_score": 0, "reason_codes": ["RATE_LIMIT_EXCEEDED"], "policy_version": 1, "ttl_seconds": 0, "retry_after_seconds": 12 } }, "fallback": "fail_open", "expect": { "outcome": 429, "retry_after": 12, "cacheable": false } },
    { "name": "rate_limit sin retry_after",    "api": { "status": 200, "body": { "action": "rate_limit", "risk_score": 70, "reason_codes": ["SCORE_THRESHOLD"], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": 429, "retry_after": 1, "cacheable": false } },
    { "name": "F3-11 Valkey caído, fail_open", "api": { "status": 200, "body": { "action": "allow", "risk_score": 0, "reason_codes": ["RATE_LIMIT_UNAVAILABLE", "FALLBACK_OPEN"], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_closed", "expect": { "outcome": "next", "cacheable": false } },
    { "name": "F3-12 Valkey caído, fail_closed","api": { "status": 200, "body": { "action": "rate_limit", "risk_score": 0, "reason_codes": ["RATE_LIMIT_UNAVAILABLE", "FALLBACK_CLOSED"], "policy_version": 1, "ttl_seconds": 0, "retry_after_seconds": 5 } }, "fallback": "fail_open", "expect": { "outcome": 429, "retry_after": 5, "cacheable": false } },
    { "name": "payment_required",              "api": { "status": 200, "body": { "action": "payment_required", "risk_score": 0, "reason_codes": ["LICENSE_REQUIRED"], "policy_version": 1, "ttl_seconds": 0, "payment": { "plan_id": "plan_1", "checkout_url": "https://botgate.example/buy/plan_1", "currency": "EUR", "unit_price_minor": 150, "unit_size": 1000 } } }, "fallback": "fail_open", "expect": { "outcome": 402, "cacheable": false } },
    { "name": "Publish I2: allow con license (campo nuevo, se tolera)", "api": { "status": 200, "body": { "action": "allow", "risk_score": 0, "reason_codes": ["LICENSE_VALID"], "policy_version": 1, "ttl_seconds": 0, "license": { "grant_id": "01a15443-049a-706a-ac7e-f842d27dc205", "plan_id": "plan_1", "data_scope": "distributor-a" } } }, "fallback": "fail_open", "expect": { "outcome": "next", "cacheable": false } },
    { "name": "Publish I2: block PUBLISH_ROUTE_NOT_LICENSED", "api": { "status": 200, "body": { "action": "block", "risk_score": 0, "reason_codes": ["PUBLISH_ROUTE_NOT_LICENSED"], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": 403, "cacheable": false } },
    { "name": "challenge (sin proveedor): se trata como block", "api": { "status": 200, "body": { "action": "challenge", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": 403, "cacheable": false } },
    { "name": "F3-13 API 429 propio, fail_open",  "api": { "status": 429, "headers": { "retry-after": "30" }, "body": { "type": "x", "title": "Too Many Requests", "status": 429 } }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "F3-13 API 429 propio, fail_closed","api": { "status": 429, "headers": { "retry-after": "30" }, "body": { "type": "x", "title": "Too Many Requests", "status": 429 } }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "F3-13 API 500, fail_open",      "api": { "status": 500, "body": { "type": "x", "title": "Internal Server Error", "status": 500 } }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "F3-13 API 500, fail_closed",    "api": { "status": 500, "body": { "type": "x", "title": "Internal Server Error", "status": 500 } }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "API 401 (clave revocada)",      "api": { "status": 401, "body": { "type": "x", "title": "Unauthorized", "status": 401 } }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "API 400",                       "api": { "status": 400, "body": { "type": "x", "title": "Bad Request", "status": 400 } }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "200 con JSON inválido",         "api": { "status": 200, "raw": "{no es json" }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "200 con acción desconocida",    "api": { "status": 200, "body": { "action": "teleport", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "200 sin campos obligatorios",   "api": { "status": 200, "body": { "action": "allow" } }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "200 HTML (proxy intermedio)",   "api": { "status": 200, "raw": "<html>login</html>", "content_type": "text/html" }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "retry_after negativo/no entero se ignora", "api": { "status": 200, "body": { "action": "rate_limit", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 0, "retry_after_seconds": -3 } }, "fallback": "fail_open", "expect": { "outcome": 429, "retry_after": 1, "cacheable": false } },
    { "name": "timeout, fail_open",            "api": { "delay_ms": 1000, "status": 200, "body": { "action": "block", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "timeout, fail_closed",          "api": { "delay_ms": 1000, "status": 200, "body": { "action": "allow", "risk_score": 0, "reason_codes": [], "policy_version": 1, "ttl_seconds": 0 } }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } },
    { "name": "API caída, fail_open",          "api": { "down": true }, "fallback": "fail_open", "expect": { "outcome": "next", "fallback_used": true } },
    { "name": "API caída, fail_closed",        "api": { "down": true }, "fallback": "fail_closed", "expect": { "outcome": 503, "retry_after": 5, "fallback_used": true } }
  ]
}
