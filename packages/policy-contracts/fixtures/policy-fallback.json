    "/datos/**",
    "/informes/**"
   ],
   "without_policy": "fallback",
   "policy": {
    "trusted": false,
    "licensed_routes": [
     {
      "route_pattern": "/informes/**",
      "methods": []
     }
    ],
    "rules": [],
    "default_fallback": "fail_open"
   },
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/catalogo",
    "token": false
   },
   "expect": {
    "fallback": "fail_open",
    "reason": "global_fallback"
   }
  },
  {
   "name": "política caducada: sus reglas fail_open ya no se aplican",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": {
    "trusted": false,
    "licensed_routes": [],
    "rules": [
     {
      "path_pattern": "/api/**",
      "methods": [],
      "priority": 1,
