{
 "description": "BL-11 (Fase 8): fallback efectivo cuando la Decision API no da una decisión. `policy`: null (nunca descargada o corrupta) o política verificada; `trusted: false` = caducada. `unsafe_config` se deriva: la política tiene rutas de pago que local_licensed no cubre y without_policy no es deny. `covers`: si la declaración local cubre un patrón licenciado (comparación conservadora). Compartido por los SDK de Express y Rails.",
 "cases": [
  {
   "name": "primera instalación, API caída: ruta de pago declarada, SIN token -> cerrada",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": null,
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/datos/1",
    "token": false
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "licensed_local"
   }
  },
  {
   "name": "primera instalación: ruta de pago declarada, con token -> cerrada",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": null,
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/datos/1",
    "token": true
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "licensed_local"
   }
  },
  {
   "name": "primera instalación: ruta libre con fail_open -> abierta",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": null,
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/catalogo",
    "token": false
   },
   "expect": {
    "fallback": "fail_open",
    "reason": "global_fallback"
   }
  },
  {
   "name": "primera instalación: token en ruta no declarada -> cerrada (nunca gratis algo que dice ser de pago)",
   "local_licensed": [],
   "without_policy": "fallback",
   "policy": null,
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/otra",
    "token": true
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "no_policy_token"
   }
  },
  {
   "name": "primera instalación, modo estricto: ruta libre -> cerrada",
   "local_licensed": [],
   "without_policy": "deny",
   "policy": null,
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/catalogo",
    "token": false
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "no_policy_strict"
   }
  },
  {
   "name": "política confiable con ruta de pago no declarada en local -> cerrada",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": {
    "trusted": true,
    "licensed_routes": [
     {
      "route_pattern": "/informes/**",
      "methods": []
     }
    ],
    "rules": [],
    "default_fallback": "fail_open"
   },
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/informes/2",
    "token": false
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "licensed_policy"
   }
  },
  {
   "name": "ruta de pago de la política solo para POST: GET no se cierra por ella",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": {
    "trusted": true,
    "licensed_routes": [
     {
      "route_pattern": "/informes/**",
      "methods": [
       "POST"
      ]
     }
    ],
    "rules": [],
    "default_fallback": "fail_open"
   },
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/informes/2",
    "token": false
   },
   "expect": {
    "fallback": "fail_open",
    "reason": "global_fallback"
   }
  },
  {
   "name": "política CADUCADA: sus rutas de pago siguen cerradas",
