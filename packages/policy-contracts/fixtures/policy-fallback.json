    "trusted": false,
    "licensed_routes": [
     {
      "route_pattern": "/informes/**",
      "methods": []
     }
    ],
    "rules": [],
    "default_fallback": "fail_open"
   },
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/informes/2",
    "token": false
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "licensed_policy"
   }
  },
  {
   "name": "política caducada con rutas de pago no declaradas: configuración insegura -> rutas libres cerradas",
   "local_licensed": [
    "/datos/**"
   ],
   "without_policy": "fallback",
   "policy": {
    "trusted": false,
    "licensed_routes": [
     {
      "route_pattern": "/informes/**",
      "methods": []
     }
    ],
    "rules": [],
    "default_fallback": "fail_open"
   },
   "route_fallbacks": {},
   "fallback": "fail_open",
   "request": {
    "method": "GET",
    "path": "/catalogo",
    "token": false
   },
   "expect": {
    "fallback": "fail_closed",
    "reason": "no_policy_unsafe_config"
   }
  },
  {
   "name": "política caducada, todas sus rutas de pago declaradas: ruta libre con su fallback",
