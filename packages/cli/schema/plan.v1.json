{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:licenroute:cli:plan:v1",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "target",
    "writes_files",
    "summary",
    "proposed_plans",
    "excluded",
    "needs_decision",
    "unresolved",
    "integration",
    "tests",
    "warnings",
    "approval"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "licenroute.cli.plan/v1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "@licenroute/cli"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "const": "express"
        },
        {
          "type": "string",
          "const": "rails"
        }
      ]
    },
    "writes_files": {
      "type": "boolean",
      "const": false,
      "description": "plan nunca escribe ni modifica archivos."
    },
    "summary": {
      "type": "object",
      "required": [
        "routes",
        "candidates",
        "excluded",
        "needs_decision",
        "unresolved"
      ],
      "properties": {
        "routes": {
          "type": "integer"
        },
        "candidates": {
          "type": "integer"
        },
        "excluded": {
          "type": "integer"
        },
        "needs_decision": {
          "type": "integer"
        },
        "unresolved": {
          "type": "integer"
        }
      }
    },
    "proposed_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "route_pattern",
          "methods",
          "routes",
          "reason",
          "already_licensed",
          "requires_confirmation"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "route_pattern": {
            "type": "string",
            "description": "Patrón de LicenRoute (glob) que cubriría las rutas."
          },
          "methods": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "GET"
                },
                {
                  "type": "string",
                  "const": "HEAD"
                },
                {
                  "type": "string",
                  "const": "POST"
                },
                {
                  "type": "string",
                  "const": "PUT"
                },
                {
                  "type": "string",
                  "const": "PATCH"
                },
                {
                  "type": "string",
                  "const": "DELETE"
                },
                {
                  "type": "string",
                  "const": "OPTIONS"
                },
                {
                  "type": "string",
                  "const": "ALL"
                }
              ]
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "ids de ruta"
            }
          },
          "reason": {
            "type": "string"
          },
          "already_licensed": {
            "type": "boolean",
            "description": "Ya cubierto por licensedPaths de una integración existente."
          },
          "requires_confirmation": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "method",
          "path",
          "source",
          "reason"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "const": "GET"
              },
              {
                "type": "string",
                "const": "HEAD"
              },
              {
                "type": "string",
                "const": "POST"
              },
              {
                "type": "string",
                "const": "PUT"
              },
              {
                "type": "string",
                "const": "PATCH"
              },
              {
                "type": "string",
                "const": "DELETE"
              },
              {
                "type": "string",
                "const": "OPTIONS"
              },
              {
                "type": "string",
                "const": "ALL"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Nunca se protegen con licencias automáticamente (salud, autenticación, webhooks, estáticos)."
    },
    "needs_decision": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "method",
          "path",
          "source",
          "reason"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "const": "GET"
              },
              {
                "type": "string",
                "const": "HEAD"
              },
              {
                "type": "string",
                "const": "POST"
              },
              {
                "type": "string",
                "const": "PUT"
              },
              {
                "type": "string",
                "const": "PATCH"
              },
              {
                "type": "string",
                "const": "DELETE"
              },
              {
                "type": "string",
                "const": "OPTIONS"
              },
              {
                "type": "string",
                "const": "ALL"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Requieren decisión humana (escrituras, administración, rutas ya autenticadas, comodines)."
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line",
          "kind",
          "reason",
          "snippet"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "snippet": {
            "type": "string",
            "maxLength": 160,
            "description": "Fragmento saneado (sin caracteres de control), truncado."
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "required": [
        "already_integrated",
        "dependencies",
        "file_changes",
        "env",
        "order_warning"
      ],
      "properties": {
        "already_integrated": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ecosystem",
              "name",
              "source"
            ],
            "properties": {
              "ecosystem": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "npm"
                  },
                  {
                    "type": "string",
                    "const": "rubygems"
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "file_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "action",
              "sha256",
              "description"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "action": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "modify"
                  },
                  {
                    "type": "string",
                    "const": "create"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Hash actual (null si el fichero no existe): S6 se negará a aplicar si cambia."
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "secret"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "secret": {
                "type": "boolean"
              }
            }
          }
        },
        "order_warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "request",
          "expect_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "request": {
            "type": "object",
            "required": [
              "method",
              "path",
              "license",
              "central"
            ],
            "properties": {
              "method": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "GET"
                  },
                  {
                    "type": "string",
                    "const": "HEAD"
                  },
                  {
                    "type": "string",
                    "const": "POST"
                  },
                  {
                    "type": "string",
                    "const": "PUT"
                  },
                  {
                    "type": "string",
                    "const": "PATCH"
                  },
                  {
                    "type": "string",
                    "const": "DELETE"
                  },
                  {
                    "type": "string",
                    "const": "OPTIONS"
                  },
                  {
                    "type": "string",
                    "const": "ALL"
                  }
                ]
              },
              "path": {
                "type": "string"
              },
              "license": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "none"
                  },
                  {
                    "type": "string",
                    "const": "valid"
                  },
                  {
                    "type": "string",
                    "const": "other_plan"
                  },
                  {
                    "type": "string",
                    "const": "forged"
                  },
                  {
                    "type": "string",
                    "const": "revoked"
                  },
                  {
                    "type": "string",
                    "const": "exhausted"
                  }
                ]
              },
              "central": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "up"
                  },
                  {
                    "type": "string",
                    "const": "down"
                  }
                ]
              }
            }
          },
          "expect_status": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "plan_sha256",
        "files"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "description": "Todos los ficheros en los que se basa el plan."
        }
      }
    }
  }
}
